{
  "name": "azure-trivy-docker-scanner",
  "version": "0.3.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:task": "npm run build && node scripts/build-task.js",
    "build:hub": "webpack --mode production",
    "build:all": "npm run build:task && npm run build:hub",
    "package": "npm run build:all && tfx extension create --manifest-globs vss-extension.json --output-path out",
    "test": "jest",
    "lint": "eslint src test --ext .ts,.tsx --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "azure-devops-extension-api": "^4.270.0",
    "azure-devops-extension-sdk": "^4.2.0",
    "azure-pipelines-task-lib": "^4.17.0",
    "react": "^16.14.0",
    "react-dom": "^16.14.0"
  },
  "devDependencies": {
    "@testing-library/react": "^12.1.5",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/react": "^16.14.70",
    "@types/react-dom": "^16.9.25",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "css-loader": "^7.1.4",
    "eslint": "^8.57.0",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.3.0",
    "style-loader": "^4.0.0",
    "tfx-cli": "^0.17.0",
    "ts-jest": "^29.1.4",
    "ts-loader": "^9.6.2",
    "typescript": "^5.4.5",
    "webpack": "^5.109.2",
    "webpack-cli": "^5.1.4"
  }
}
